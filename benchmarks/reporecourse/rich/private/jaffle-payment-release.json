  "witnesses": [
    {
      "organization": "independent",
      "actions": [
        {
          "worker": "w0",
          "action": {
            "tool": "publish",
            "name": "order_payments",
            "format": "sql",
            "content": "SELECT o.id AS order_id, o.user_id AS customer_id, coalesce(sum(p.amount),0) AS amount_cents, count(p.id) AS payment_count FROM orders o LEFT JOIN payments p ON o.id=p.order_id GROUP BY o.id,o.user_id ORDER BY o.id",
            "bindings": {},
            "obligations": [
              "order_payments"
            ]
          }
        },
        {
          "worker": "w1",
          "action": {
            "tool": "publish",
            "name": "customer_summary",
            "format": "sql",
            "content": "SELECT c.id AS customer_id, coalesce(sum(p.amount),0) AS amount_cents, count(p.id) AS payment_count, count(DISTINCT o.id) AS order_count FROM customers c LEFT JOIN orders o ON c.id=o.user_id LEFT JOIN payments p ON o.id=p.order_id GROUP BY c.id ORDER BY c.id",
            "bindings": {},
            "obligations": [
              "customer_summary"
            ]
          }
        },
        {
          "worker": "w2",
          "action": {
            "tool": "publish",
            "name": "method_summary",
            "format": "sql",
            "content": "SELECT payment_method, sum(amount) AS amount_cents, count(id) AS payment_count FROM payments GROUP BY payment_method ORDER BY payment_method",
            "bindings": {},
            "obligations": [
              "method_summary"
            ]
          }
        },
        {
          "worker": "w3",
          "action": {
            "tool": "publish",
            "name": "reconciliation",
            "format": "sql",
            "content": "SELECT c.id AS customer_id, sum(CASE WHEN x.payment_count>0 THEN 1 ELSE 0 END) AS paid_orders, sum(CASE WHEN x.payment_count=0 THEN 1 ELSE 0 END) AS unpaid_orders, coalesce(sum(x.amount_cents),0) AS recorded_cents FROM customers c LEFT JOIN (SELECT o.id AS order_id, o.user_id AS customer_id, coalesce(sum(p.amount),0) AS amount_cents, count(p.id) AS payment_count FROM orders o LEFT JOIN payments p ON o.id=p.order_id GROUP BY o.id,o.user_id) x ON c.id=x.customer_id GROUP BY c.id ORDER BY c.id",
            "bindings": {},
            "obligations": [
              "reconciliation"
            ]
          }
        }
