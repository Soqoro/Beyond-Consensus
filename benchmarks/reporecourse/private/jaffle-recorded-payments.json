            "content": "SELECT c.id AS customer_id, coalesce(sum(p.amount), 0) / 100.0 AS recorded_dollars, count(p.id) AS payment_records FROM customers c LEFT JOIN orders o ON c.id = o.user_id LEFT JOIN payments p ON o.id = p.order_id GROUP BY c.id ORDER BY c.id",
